        "def Newton(p0,tol):\n",
        "    e=100\n",
        "    p0=0.5\n",
        "    error=[]\n",
        "    lista=[]\n",
        "    while e>tol:\n",
        "      p1=p0-(3*p0**2-np.exp(p0))/(6*p0-np.exp(p0))\n",
        "      lista.append(p1)\n",
        "      e=np.abs(p1-p0)\n",
        "      error.append(e)\n",
        "      p0=p1\n",
        "    return lista, error"
      ],
      "metadata": {
        "id": "Cyu_cjZfJkuk"
      },
